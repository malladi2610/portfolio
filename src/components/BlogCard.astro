---
import TopicPill from "./TopicPill.astro";
const {
  href,
  title,
  description,
  topic,
  topics,
  pubDate,
  tags,
  readingTime,
  heroImage
} = Astro.props;
const postTopics = Array.isArray(topics) && topics.length > 0 ? topics : topic ? [topic] : [];
const published = new Date(pubDate);
const format = (date) => date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
---
<article class:list={["blog-card", heroImage && "blog-card--with-image"]}>
  {heroImage && (
    <a class="blog-card__image" href={href}>
      <img src={heroImage} alt="" loading="lazy" />
    </a>
  )}
  <div class="blog-card__body">
    <div class="blog-card__meta">
      {postTopics.map((postTopic) => (
        <TopicPill topic={postTopic} />
      ))}
      <span>{format(published)}</span>
      <span>{readingTime}</span>
    </div>
    <h2 class="blog-card__title"><a href={href}>{title}</a></h2>
    <p class="blog-card__description">{description}</p>
    {tags && tags.length > 0 && (
      <div class="blog-card__tags">
        {tags.map((tag) => (
          <span class="tag" key={tag}>#{tag}</span>
        ))}
      </div>
    )}
  </div>
</article>
